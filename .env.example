# ============================================================
# Variables d'environnement — guide-hypotheque.ca
# Copier ce fichier en .env.local pour le dev local
# Ajouter ces variables dans Vercel > Settings > Environment Variables
# ============================================================

# Site URL (sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://guide-hypotheque.ca

# --- EMAIL (Resend) ---
# Créer un compte sur https://resend.com — gratuit jusqu'à 100 emails/jour
# Vérifier votre domaine guide-hypotheque.ca dans Resend > Domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Adresse expéditeur (doit utiliser votre domaine vérifié dans Resend)
FROM_EMAIL=leads@guide-hypotheque.ca

# --- GOOGLE ANALYTICS 4 ---
# Créer une propriété GA4 sur https://analytics.google.com
# Copier l'ID de mesure (format G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- PARTENAIRES (à intégrer plus tard) ---
NESTO_API_KEY=
RATEHUB_API_KEY=
