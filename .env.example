# Database
DATABASE_URL=

# Partner API keys
NESTO_API_KEY=
RATEHUB_API_KEY=

# Email service (ConvertKit / MailerLite / Resend)
EMAIL_API_KEY=

# Site URL (for sitemap, OG, etc.)
NEXT_PUBLIC_SITE_URL=https://guide-hypotheque.ca

# Supabase (projet partagé guide-taechir, tables préfixées gh_)
# URL + clé publishable sont PUBLIQUES (sécurité via RLS + RPC protégées).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-mails sortants — expéditeur unifié (domaine/expéditeur authentifié DKIM chez Brevo)
MAIL_FROM_EMAIL=contact@guide-hypotheque.ca
CONTACT_EMAIL=contact@guide-hypotheque.ca

# Brevo (notifications internes, réponses de marque, newsletter, nurturing) — gated : inactif si vide
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_LEADS_LIST_ID=

# Tracking (chargé APRÈS consentement cookies uniquement) — gated : inactif si vide
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_UET_TAG_ID=
